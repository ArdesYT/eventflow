# Database (MariaDB / MySQL)
# XAMPP: gyakran DB_USER=root, DB_PASS=(üres). Docker: eventflow/eventflow.
DB_HOST=localhost
DB_PORT=3306
DB_USER=eventflow
DB_PASS=change-me
DB_NAME=eventflow

# Auth — REQUIRED in production (npm run start)
JWT_SECRET=generate-a-long-random-secret-here
JWT_EXPIRES_IN=7d

# Server
PORT=3000
NODE_ENV=development

# CORS — set to your frontend URL in production
CLIENT_URL=http://localhost:5173

# Optional: bcrypt cost (default 10)
BCRYPT_SALT_ROUNDS=10
